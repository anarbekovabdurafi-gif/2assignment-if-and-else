a, b, c, d = map(int, input().split())

if a == 0:
    if b != 0:
        print("NO")
    elif c != 0:
        print("INF")
    else:
        print("INF")
else:
    if (-b) % a != 0:
        print("NO")
    else:
        x = -b // a

        if c * x + d == 0:
            print("NO")
        else:
            print(x)
